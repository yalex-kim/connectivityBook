{
  "name": "connectivitybook-video",
  "private": true,
  "description": "ConnectivityBook 내용을 Remotion으로 만든 영상",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render AfhExplainerVoice out/afh-explainer.mp4",
    "still": "remotion still AfhExplainer out/still.png --frame=1500",
    "check": "node scripts/check-book.mjs && tsc --noEmit",
    "render:silent": "remotion render AfhExplainer out/afh-explainer-silent.mp4",
    "narrate": "python3 scripts/narrate.py",
    "loudnorm": "ffmpeg -y -i out/afh-explainer.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -c:a aac -b:a 192k out/afh-explainer-final.mp4",
    "youtube": "esbuild scripts/youtube.ts --bundle --platform=node --log-level=warning --outfile=out/youtube.cjs && node out/youtube.cjs",
    "thumbnail": "remotion still AfhThumbnail out/youtube/thumbnail.png",
    "thumbnail:discover": "remotion still DiscoverThumbnail out/youtube-discover/thumbnail.png",
    "thumbnail:twokinds": "remotion still TwoKindsThumbnail out/youtube-twokinds/thumbnail.png",
    "thumbnail:range": "remotion still RangeThumbnail out/youtube-range/thumbnail.png",
    "thumbnail:connection": "remotion still ConnectionThumbnail out/youtube-connection/thumbnail.png",
    "thumbnail:gatt": "remotion still GattThumbnail out/youtube-gatt/thumbnail.png",
    "thumbnail:pairing": "remotion still PairingThumbnail out/youtube-pairing/thumbnail.png",
    "thumbnail:power": "remotion still PowerThumbnail out/youtube-power/thumbnail.png",
    "thumbnail:audio": "remotion still AudioThumbnail out/youtube-audio/thumbnail.png",
    "thumbnail:locate": "remotion still LocateThumbnail out/youtube-locate/thumbnail.png",
    "thumbnail:scheduling": "remotion still SchedulingThumbnail out/youtube-scheduling/thumbnail.png",
    "thumbnail:instant": "remotion still InstantThumbnail out/youtube-instant/thumbnail.png",
    "thumbnail:hopping": "remotion still HoppingThumbnail out/youtube-hopping/thumbnail.png",
    "thumbnail:gattcache": "remotion still GattCacheThumbnail out/youtube-gattcache/thumbnail.png",
    "thumbnail:encrypt": "remotion still EncryptThumbnail out/youtube-encrypt/thumbnail.png",
    "thumbnail:privacy": "remotion still PrivacyThumbnail out/youtube-privacy/thumbnail.png",
    "thumbnail:sync": "remotion still SyncThumbnail out/youtube-sync/thumbnail.png",
    "thumbnail:direction": "remotion still DirectionThumbnail out/youtube-direction/thumbnail.png"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.537",
    "@remotion/three": "4.0.537",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
